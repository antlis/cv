---
//
//  Layout.astro
//  CV Hub
//
//  Created by Alexander Gusarov on 03.03.2026.
//  @spartan121
//
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { makeT } from '../scripts/t';
import { ThemeScript, Toggle } from 'astro-theme-toggle/components';

const {
  title = 'Anton Lisovsky',
  lang = 'en',
  section = 'main',
  profile = '',
  description,
  ogImage,
  customLangLinks,
} = Astro.props;

// --- Config ---
const langConfig    = await getEntry('languages', 'languages');
let profileConfig = null;
try { profileConfig = await getEntry('profiles', 'profiles'); } catch {}
const translations  = await getEntry('i18n', 'translations');

const defaultLang = langConfig?.data?.default ?? 'en';
const allLangs    = langConfig?.data?.languages ?? [];
const allProfiles = profileConfig?.data?.profiles ?? [];
const t = makeT(translations?.data ?? {}, lang);

// --- Meta ---
const repo = import.meta.env.GITHUB_REPOSITORY;
const [owner] = repo ? repo.split('/') : [null];
const siteOrigin = owner
  ? `https://${owner}.github.io`
  : 'http://localhost:4321';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const metaDescription = description ?? t('meta.description');
const metaImage = ogImage ?? `${siteOrigin}${base}/og-image.png`;
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;

// --- Navigation ---
function buildHref(profileSlug: string, langId: string): string {
  const segments = [];
  if (profileSlug) segments.push(profileSlug);
  if (langId !== defaultLang) segments.push(langId);
  return `${base}/${segments.join('/')}`;
}

const homeHref     = buildHref(profile, lang);

const isShowcaseIndex = Astro.url.pathname === `${base}/showcase`;
const showcaseHref = lang === defaultLang
  ? `${base}/showcase`
  : `${base}/showcase/${lang}`;

const langLinks = customLangLinks ?? allLangs.map(l => ({
  id:     l.id,
  label:  l.label,
  href:   buildHref(profile, l.id),
  active: l.id === lang,
}));

const profileLinks = allProfiles.map(p => ({
  id:     p.id,
  label:  p.label,
  href:   buildHref(p.slug, lang),
  active: p.slug === profile,
}));

const currentYear = new Date().getFullYear();
const authorGit = 'https://github.com/KeeGooRoomiE/cv_hub';
const authorGitHubPage = 'https://github.com/KeeGooRoomiE/';
---

<!doctype html>
<html lang={lang} data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:locale" content={t('meta.locale')} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />

    <ThemeScript />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header>
      <nav>
        <a href={homeHref} class="logo" aria-label="Home">
          <img src="/logo.svg" width="48" height="48" alt="Logo" style="object-fit: contain;" />
        </a>

        <div class="nav-links">
          <a href={homeHref}>{t('nav.home')}</a>

          {profileLinks.length > 1 && (
            <div class="dropdown">
              <button
                class="dropdown__trigger"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="role-menu"
              >
                {t('nav.role')} ▾
              </button>
              <ul class="dropdown__menu" id="role-menu">
                {profileLinks.map(p => (
                  <li>
                    <a href={p.href} class={p.active ? 'active' : ''}>
                      {p.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <a href={showcaseHref}>{t('nav.showcase')}</a>
        </div>

        <div class="nav-end">
          <div class="lang-switcher">
            {langLinks.map((l, i) => (
              <>
                {i > 0 && <span class="sep">/</span>}
                <a class={l.active ? 'active' : ''} href={l.href}>{l.label}</a>
              </>
            ))}
          </div>
          <span class="theme-toggle-wrap"><Toggle /></span>
          <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="hamburger"></span>
          </button>
        </div>
      </nav>

      <div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
        <div class="mobile-links">
          <a href={homeHref}>{t('nav.home')}</a>
          {profileLinks.length > 1 && profileLinks.map(p => (
            <a href={p.href} class:list={{ active: p.active }}>{p.label}</a>
          ))}
          <a href={showcaseHref}>{t('nav.showcase')}</a>
          <div class="mobile-lang">
            {langLinks.map((l, i) => (
              <>
                {i > 0 && <span class="sep">/</span>}
                <a class={l.active ? 'active' : ''} href={l.href}>{l.label}</a>
              </>
            ))}
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <script>
      // Dropdown: click-toggle + click-outside to close.
      const setExpanded = (dropdown: Element, open: boolean) => {
        dropdown.querySelector('.dropdown__trigger')?.setAttribute('aria-expanded', String(open));
      };

      const closeAll = () => {
        document.querySelectorAll('.dropdown.is-open').forEach(d => {
          d.classList.remove('is-open');
          setExpanded(d, false);
        });
      };

      document.querySelectorAll<HTMLElement>('.dropdown').forEach(dropdown => {
        const trigger = dropdown.querySelector<HTMLElement>('.dropdown__trigger');
        if (!trigger) return;

        trigger.addEventListener('click', e => {
          e.stopPropagation();
          const willOpen = !dropdown.classList.contains('is-open');
          closeAll();
          if (willOpen) {
            dropdown.classList.add('is-open');
            setExpanded(dropdown, true);
          }
        });
      });

      document.addEventListener('click', () => closeAll());

      document.addEventListener('keydown', e => {
        if (e.key !== 'Escape') return;
        const open = document.querySelector<HTMLElement>('.dropdown.is-open .dropdown__trigger');
        closeAll();
        open?.focus();
      });

      // Mobile menu
      function initMobileMenu() {
        const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
        const menu = document.querySelector<HTMLElement>('.mobile-menu');
        if (!toggle || !menu) return;
        if (toggle.dataset.menuReady === 'true') return;
        toggle.dataset.menuReady = 'true';

        const openLabel = toggle.getAttribute('aria-label') || 'Open menu';
        const closeLabel = openLabel === 'Открыть меню' ? 'Закрыть меню' : 'Close menu';

        function setMenuOpen(open: boolean) {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
          menu.setAttribute('aria-hidden', String(!open));
          menu.toggleAttribute('inert', !open);
          menu.classList.toggle('open', open);
        }

        toggle.addEventListener('click', () => {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          setMenuOpen(!expanded);
        });

        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => setMenuOpen(false));
        });

        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true') return;
          setMenuOpen(false);
          toggle.focus();
        });
      }

      initMobileMenu();
    </script>

    <footer class="footer">
      <div class="footer__inner">
        <small class="footer-copyright">&copy; {new Date().getFullYear()} antlis</small>
        <div class="footer-actions">
          <a href="mailto:antlis@protonmail.com" target="_blank" rel="noopener" aria-label="Email" data-brand="email">
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/protonmail.svg" alt="Email" width="20" height="20" />
          </a>
          <a href="https://github.com/antlis" target="_blank" rel="noopener" aria-label="GitHub" data-brand="github">
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/github.svg" alt="GitHub" width="20" height="20" />
          </a>
          <a href="https://gitlab.com/antlis" target="_blank" rel="noopener" aria-label="GitLab" data-brand="gitlab">
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/gitlab.svg" alt="GitLab" width="20" height="20" />
          </a>
          <a href="https://www.linkedin.com/in/antlis/" target="_blank" rel="noopener" aria-label="LinkedIn" data-brand="linkedin">
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/linkedin.svg" alt="LinkedIn" width="20" height="20" />
          </a>
          <a href="https://t.me/Balkon1111" target="_blank" rel="noopener" aria-label="Telegram" data-brand="telegram">
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/telegram.svg" alt="Telegram" width="20" height="20" />
          </a>
          <a href="https://stackoverflow.com/users/2983061/antlis" target="_blank" rel="noopener" aria-label="StackOverflow" data-brand="stackoverflow">
            <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/stackoverflow.svg" alt="StackOverflow" width="20" height="20" />
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
